PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/meridian
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=8h

# Seed the first administrator. The API hashes this password with bcrypt.
ADMIN_NAME=Workspace Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_REGISTRATION_KEY=replace-with-a-long-random-registration-key

# Optional initial User account. Users can also create User accounts on the login page.
USER_NAME=Workspace User
USER_EMAIL=user@example.com
USER_PASSWORD=replace-with-a-strong-password

# SMTP settings used by the outbound email utility.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
MAIL_FROM=Meridian Freight <no-reply@example.com>
